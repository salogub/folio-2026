---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

// One page per case study, at /work/<filename>.
export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    ({ data }) => !data.draft && !data.externalCase,
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, year, summary } = project.data;
const { Content } = await render(project);
---

<Base title={`${title} — ${site.name}`} description={summary}>
  <div class="container page">
    <header class="header" id="top">
      <a class="back" href="/">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <path d="M10.5 1 6 5l4.5 4M6 5h12.5" />
        </svg>
        <span class="label">Back to Main</span>
      </a>
      <nav class="contacts" aria-label="Contacts">
        <a href={site.email}>Email</a>
        <a href={site.linkedin}>LinkedIn</a>
      </nav>
    </header>

    <main>
      <div class="heading">
        <h1>{title}</h1>
        <p class="year">{year}</p>
      </div>
      <p class="summary">{summary}</p>
      <div class="content">
        <Content />
      </div>
    </main>

    <footer class="footer">
      <a href="#top">Back to top</a>
    </footer>
  </div>
</Base>

<style>
  .page {
    padding-top: 80px;
    padding-bottom: 40px;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .back {
    text-decoration: none;
  }

  .back .label {
    text-decoration: underline;
  }

  .back svg {
    margin-right: 6px;
  }

  .back path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contacts {
    display: flex;
    gap: 40px;
  }

  /* Title and year are separate elements, side by side on one line. */
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 20px;
    margin-top: 80px;
    font-size: 40px;
    font-weight: 500;
    /* Web Inter sets large sizes slightly looser than Figma's; this matches the mockup. */
    letter-spacing: -0.015em;
  }

  .year {
    color: var(--color-muted);
  }

  .summary {
    max-width: 340px;
    line-height: var(--line-height-summary);
    margin-top: 40px;
  }

  /* The case study body, written in Markdown: every block 40px apart. */
  .content {
    margin-top: 40px;
  }

  .content > :global(* + *) {
    margin-top: 40px;
  }

  /* Text blocks keep the narrow measure from the Figma template;
     paragraphs holding an image span the full column. */
  .content :global(p:not(:has(> img))) {
    max-width: 340px;
  }

  .content :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .footer {
    margin-top: 80px;
  }

  @media (max-width: 759px) {
    .contacts {
      display: none;
    }

    .heading {
      font-size: 24px;
      letter-spacing: normal;
    }

    .content :global(img) {
      border-radius: 6px;
    }
  }
</style>
