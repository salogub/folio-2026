---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Project from '../components/Project.astro';
import Slider from '../components/Slider.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { site, otherImages } from '../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Slider images for "Other": every file in src/images/other/, in name order.
const otherFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../images/other/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const other = Object.entries(otherFiles)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, mod]) => ({
    src: mod.default,
    alt:
      otherImages.find((image) => path.endsWith(`/${image.file}`))?.alt ??
      'Other design work',
  }));
---

<Base title={`${site.name} — ${site.role}`} description={site.intro}>
  <div class="container page">
    <header class="header" id="top">
      <div class="intro-block">
        <h1 class="name">{site.name}</h1>
        <p class="role">{site.role}</p>
      </div>
      <p class="intro">{site.intro}</p>
      <nav class="contacts" aria-label="Contacts">
        <a href={site.email}>Email</a>
        <a href={site.linkedin}>LinkedIn</a>
      </nav>
    </header>

    <main>
      <section class="works" aria-labelledby="works-heading">
        <h2 class="works-heading" id="works-heading">Works</h2>
        <div class="projects">
          {projects.map((project, i) => <Project project={project} eager={i === 0} />)}
        </div>
      </section>

      <section class="other" aria-labelledby="other-heading">
        <h2 class="works-heading" id="other-heading">Other</h2>
        <Slider images={other} label="Other" position="top" />
        <div class="other-links">
          <ArrowLink label="More work on Dribbble" href={site.dribbble} external />
        </div>
      </section>
    </main>

    <footer class="footer">
      <a href="#top">Back to top</a>
    </footer>
  </div>
</Base>

<style>
  .page {
    padding-top: 80px;
    padding-bottom: 40px;
  }

  /* Desktop: name on the left, contacts on the right, intro below. */
  .header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name contacts'
      'intro intro';
    align-items: start;
  }

  .intro-block {
    grid-area: name;
    font-size: 32px;
    font-weight: 500;
    /* Web Inter sets 32px slightly looser than Figma's; this matches the mockup. */
    letter-spacing: -0.015em;
  }

  .role {
    color: var(--color-muted);
  }

  .intro {
    grid-area: intro;
    max-width: 340px;
    margin-top: 40px;
  }

  .contacts {
    grid-area: contacts;
    display: flex;
    gap: 40px;
  }

  .works {
    margin-top: 80px;
  }

  .works-heading {
    font-size: 20px;
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .projects {
    display: grid;
    gap: 80px;
  }

  .other {
    margin-top: 80px;
  }

  .other-links {
    margin-top: 40px;
  }

  .footer {
    margin-top: 80px;
  }

  /* Mobile: contacts move under the intro. */
  @media (max-width: 759px) {
    .header {
      grid-template-columns: 1fr;
      grid-template-areas:
        'name'
        'intro'
        'contacts';
    }

    .contacts {
      margin-top: 40px;
    }

    .projects {
      gap: 60px;
    }
  }
</style>
