---
import type { CollectionEntry } from 'astro:content';
import Slider from './Slider.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, year, summary, images, externalCase, liveWebsite } = project.data;

// Buttons under the description. Outside links open in a new tab.
const links = [
  externalCase
    ? { label: externalCase.label, href: externalCase.url, external: true }
    : { label: 'Case Study', href: `/work/${project.id}`, external: false },
  ...(liveWebsite
    ? [{ label: 'Live Website', href: liveWebsite, external: true }]
    : []),
];
---

<article class="project">
  <Slider images={images} label={title} eager={eager} />
  <div class="heading">
    <h3>{title}</h3>
    <p class="year">{year}</p>
  </div>
  <p class="summary">{summary}</p>
  <div class="links">
    {
      links.map(({ label, href, external }) => (
        <a
          class="link"
          href={href}
          {...(external && { target: '_blank', rel: 'noopener' })}
        >
          <span class="label">{label}</span>
          <svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true">
            <path d="M1 8 8 1M2 1h6v6" />
          </svg>
        </a>
      ))
    }
  </div>
</article>

<style>
  /* Title and year are separate elements, side by side on one line. */
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 20px;
    margin-top: 20px;
    font-size: 24px;
    font-weight: 500;
  }

  .year {
    color: var(--color-muted);
  }

  .summary {
    max-width: 700px;
    margin-top: 20px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 40px;
  }

  .link {
    text-decoration: none;
  }

  .label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .link svg {
    margin-left: 10px;
  }

  .link path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }
</style>
