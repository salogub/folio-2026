---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  label: string;
  // Load the first image right away (for the top of the page).
  eager?: boolean;
}

const { images, label, eager = false } = Astro.props;

// Until real images are added, show grey boxes like the Figma layout.
const placeholders = images.length === 0 ? 3 : 0;
const count = images.length || placeholders;
---

<div class="slider" data-slider>
  <div class="track" data-track role="group" aria-label={`${label} images`}>
    {
      images.map((image, i) => (
        <div class:list={['slide', i === 0 && 'is-active']}>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[400, 720, 1080, 1440]}
            sizes="(max-width: 759px) calc(100vw - 40px), 720px"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))
    }
    {
      Array.from({ length: placeholders }, (_, i) => (
        <div class:list={['slide placeholder', i === 0 && 'is-active']} aria-hidden="true" />
      ))
    }
  </div>
  {
    count > 1 && (
      <>
        <button class="arrow prev" type="button" data-prev aria-label="Previous image" hidden>
          <svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true">
            <path d="M5 1 1 5l4 4M1 5h10" />
          </svg>
        </button>
        <button class="arrow next" type="button" data-next aria-label="Next image">
          <svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true">
            <path d="m7 1 4 4-4 4M11 5H1" />
          </svg>
        </button>
      </>
    )
  }
</div>

<style>
  .slider {
    position: relative;
  }

  /* On desktop the row of images runs to the edges of the window, so the
     next (and previous) image peeks in beside the column. */
  .track {
    display: flex;
    gap: 20px;
    margin-inline: calc(-1 * var(--bleed));
    padding-inline: var(--bleed);
    scroll-padding-inline: var(--bleed);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    aspect-ratio: 720 / 476;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-placeholder);
    scroll-snap-align: start;
    /* Only the image lined up with the column is fully visible. */
    opacity: 0.07;
    transition: opacity 0.3s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    /* Keeps the button visible over white areas of an image. */
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.16);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .arrow[hidden] {
    display: none;
  }

  .prev {
    left: 20px;
  }

  .next {
    right: 20px;
  }

  .arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Mobile: just the first image, no slider. */
  @media (max-width: 759px) {
    .track {
      margin-inline: 0;
      padding-inline: 0;
      overflow: hidden;
    }

    .slide {
      border-radius: 6px;
      opacity: 1;
    }

    .slide:not(:first-child),
    .arrow {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    const prev = slider.querySelector<HTMLButtonElement>('[data-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-next]');
    if (!prev || !next) continue;
    const slides = [...track.children] as HTMLElement[];

    // Distance from one image to the next.
    const step = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return slides[0].offsetWidth + gap;
    };

    const update = () => {
      // Hide ← on the first image and → on the last.
      const max = track.scrollWidth - track.clientWidth;
      prev.hidden = track.scrollLeft <= 1;
      next.hidden = track.scrollLeft >= max - 1;

      // Highlight the image lined up with the column.
      const active = Math.round(track.scrollLeft / step());
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));
    };

    const go = (direction: number) => {
      track.scrollBy({
        left: direction * step(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
